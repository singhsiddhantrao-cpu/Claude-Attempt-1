# Copy this file to .env and fill in your own key.
# Get a key from https://console.anthropic.com (Settings -> API Keys).
# Never commit the real .env file.
ANTHROPIC_API_KEY=

# Optional. Enables the agenthog SDK, which sends traces to theagentos.space
# -- a separate third-party SaaS, unrelated to Agno's AgentOS used elsewhere
# in this repo. Leave blank to skip it entirely (nothing is sent anywhere).
# Used by app.py, and by census_agent.py (which also needs the workspace id).
# API key (agops_...): https://app.theagentos.space -> Settings -> API Keys.
# Workspace id (ws_...): sidebar chip / top-right of the dashboard.
# Prefer `agenthog init` to fill these in -- it writes a gitignored .env.
AGENTOS_API_KEY=agops_replace_me
AGENTOS_WORKSPACE_ID=ws_replace_me
AGENTOS_ENDPOINT=https://api.theagentos.space
AGENTOS_AGENT_ID=

# Only used by census_agent.py -- powers the meta/llama-3.1-8b-instruct
# explanation step via NVIDIA's OpenAI-compatible API. Get a free key at
# https://build.nvidia.com (sign in -> pick a model -> Get API Key).
NVIDIA_API_KEY=
# Optional override if you serve the model yourself (local NIM, vLLM, ...).
# Defaults to https://integrate.api.nvidia.com/v1 when unset.
LLM_BASE_URL=
