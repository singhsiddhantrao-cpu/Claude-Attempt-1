# Copy this file to .env and fill in your own key.
# Never commit the real .env file.

# --- Model provider ---------------------------------------------------------
# Pick ONE provider by filling in its key:
#
# Option A) Anthropic (Claude). Get a key at https://console.anthropic.com
#           (Settings -> API Keys). Requires prepaid credit on the account.
ANTHROPIC_API_KEY=
#
# Option B) NVIDIA (free tier). Get a key at https://build.nvidia.com
#           (starts with nvapi-). Uses NVIDIA's free OpenAI-compatible models.
#           Requires the `openai` package (in requirements.txt).
NVIDIA_API_KEY=
#
# Option C) Google Gemini (free tier). Get a key at https://aistudio.google.com
#           (starts with AIza). Fast and generous free tier -- best for this
#           pipeline. Requires the `google-genai` package (in requirements.txt).
GOOGLE_API_KEY=
#
# Provider priority when more than one key is set: Google > NVIDIA > Anthropic.
#
# Optional: override the model IDs for the chosen provider.
#   Google defaults:    gemini-2.0-flash (analysts) / gemini-2.5-flash (manager)
#   NVIDIA defaults:    meta/llama-3.3-70b-instruct (both tiers)
#   Anthropic defaults: claude-sonnet-5 (analysts) / claude-opus-4-8 (manager)
# ANALYST_MODEL=
# MANAGER_MODEL=

# Optional. Enables the agenthog SDK, which sends traces to theagentos.space
# -- a separate third-party SaaS, unrelated to Agno's AgentOS used elsewhere
# in this repo. Leave blank to skip it entirely (nothing is sent anywhere).
# Get a key (agops_...) from https://www.theagentos.space.
AGENTOS_API_KEY=
AGENTOS_AGENT_ID=
